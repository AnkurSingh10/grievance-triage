DAGSHUB_REPO_OWNER=owner_id
DAGSHUB_REPO_NAME=name
MLFLOW_EXPERIMENT_NAME=name

# Add DagsHub credentials only in .env or your shell environment.
# MLFLOW_TRACKING_USERNAME=your-dagshub-username
# MLFLOW_TRACKING_PASSWORD=your-dagshub-token

# Neon PostgreSQL with pgvector enabled
NEON_DB=postgresql://user:password@host/database?sslmode=require

# Google Gemini / LangChain
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.0-flash

# Grievance system configuration
MODEL_CHECKPOINT=outputs/submission_model.pt
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
COMPLAINT_SIMILARITY_THRESHOLD=0.85
SIMILARITY_TOP_K=5
